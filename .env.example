# Copy this file to `.env` for local development:
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)

# --- Database --------------------------------------------------------------
# Local dev: run `docker compose up -d` (see docker-compose.yml), then use:
DATABASE_URL="postgresql://cleantap:cleantap@localhost:5433/cleantap?schema=public"
# Production: use a managed Postgres connection string (Neon, Supabase, RDS…).
# If your provider gives you both a pooled and a direct URL, use the direct
# (unpooled) one here — this project's prisma.config.ts only reads one URL.

# --- Auth.js -----------------------------------------------------------
# Generate a real secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret"
# Public URL of the deployed app (used to build NFC tag URLs, email links, etc).
NEXTAUTH_URL="http://localhost:3000"

# --- Magic link email (optional) -------------------------------------------
# Leave both unset to disable magic-link sign-in; email + password still works.
# EMAIL_SERVER="smtp://user:pass@smtp.your-provider.com:587"
# EMAIL_FROM="CleanTap <no-reply@yourdomain.com>"

# --- File storage ------------------------------------------------------
# "local" writes to ./public/uploads — fine for local dev, NOT for Vercel
# (its filesystem is read-only/ephemeral in production).
STORAGE_DRIVER="local"
# Switch to "s3" for production and fill these in (works with AWS S3,
# Supabase Storage's S3-compatible endpoint, Cloudflare R2, MinIO, etc):
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="https://<project>.supabase.co/storage/v1/s3"
# S3_REGION="auto"
# S3_BUCKET="cleantap-uploads"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL_BASE="https://<project>.supabase.co/storage/v1/object/public/cleantap-uploads"

# --- Branding (see README "Rebranding") -------------------------------
APP_NAME="CleanTap"

NODE_ENV="development"
